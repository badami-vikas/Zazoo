# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Local data (analyst-only OSINT working data + runtime state — never committed).
# Broad glob so new capture/enrichment outputs can't leak; only README stays tracked.
Tools/recon/data/*.json
Tools/recon/data/*.jsonl
!Tools/recon/data/README.md

# Environment
.env
.env.local
.env.*.local
# Keep the example template
!.env.local.example

# Personal / LinkedIn export data — never commit
My Data/
Connections.csv
import_linkedin.py

# Prototype app (tracked; private repo). Exclude its local caches/secrets.
Design Bridge AI Interface (Copy)/.wrangler/
Design Bridge AI Interface (Copy)/.env

# Generated PII dumps from the LinkedIn export — never commit. Supabase (people_canonical)
# is the source of truth; these are local-only offline fallbacks, regenerated from Connections.csv.
# network.ts is DELIBERATELY NOT listed here: a dummy_-prefixed stub is tracked at that exact
# path (src/app/data/network.ts) so a fresh checkout builds (known-issues.md, 2026-07-03).
# Regenerating real data via scripts/parse-network.mjs overwrites it locally — the pre-commit
# hook (scripts/check-no-pii.sh) blocks committing it back if it looks like real PII.
Design Bridge AI Interface (Copy)/src/app/data/dbSignals.ts
Design Bridge AI Interface (Copy)/src/app/data/reconStaging.ts
Design Bridge AI Interface (Copy)/data/Invitations.csv
Design Bridge AI Interface (Copy)/data/seed_canonical.sql

# Claude internal session files. Root config and skills are reviewed project exceptions.
**/.claude/
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/launch.json
!/.claude/skills/
!/.claude/skills/**

