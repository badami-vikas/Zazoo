# Copy to .env (gitignored) and fill in for deploys.

# Public base URL for shareable helpdesk links (Copy Link uses this instead of localhost).
# Set to your deployed Cloudflare Pages domain, e.g. https://bridge-ai.pages.dev
VITE_PUBLIC_BASE_URL=

# Supabase — defaults to the live Bridge project if unset.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
