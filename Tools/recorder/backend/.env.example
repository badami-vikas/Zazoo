# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET=recordings

# --- Providers ---
TRANSCRIPTION_PROVIDER=whisper_local   # whisper_local | openai_api
LLM_PROVIDER=ollama_local              # ollama_local | anthropic_api | openai_api

# faster-whisper
WHISPER_MODEL=base.en                  # tiny.en | base.en | small.en | medium.en
WHISPER_DEVICE=auto                    # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8              # int8 | float16 | float32

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Future API providers (unused until you switch *_PROVIDER above)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- App ---
CORS_ORIGINS=http://localhost:5173
