# Recon — copy to .env.local and fill in. Every source works at zero cost without
# keys; the scheduler tunables all have sane defaults (shown here = the default).

# ── Core (optional) ───────────────────────────────────────────────────────────
# SEARXNG_URL=http://localhost:8888           # Stage-A discovery backend
# GITHUB_TOKEN=                                # 60→5000 req/hr — STRONGLY recommended
                                               #   at scheduled volume (tightest limit)
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=                        # omit → results saved to local JSONL only
# BRIDGE_WORKSPACE_ID=
# BRIDGE_USER_ID=
# CONNECTIONS_CSV=                             # path to your LinkedIn Connections.csv export

# ── Scheduler: batch size (clamped Gaussian, profiles per run) ─────────────────
# BATCH_MEAN=40
# BATCH_SD=8
# BATCH_MIN=20
# BATCH_MAX=50

# ── Scheduler: inter-run gap (clamped Gaussian, minutes) ───────────────────────
# GAP_MEAN_MIN=70
# GAP_SD_MIN=20
# GAP_MIN_MIN=40
# GAP_MAX_MIN=120

# ── Scheduler: worklist source ─────────────────────────────────────────────────
# RECON_SOURCE=csv         # csv = walk Connections.csv (the full 21,792 roster)
# RECON_SOURCE=supabase    # supabase = walk people already in Bridge (people_canonical),
                           #   least-recently-enriched first. Grows as you add people.
                           #   Requires SUPABASE_URL + SUPABASE_SERVICE_KEY.

# ── Scheduler: daytime window (local hours) + daily backstop ───────────────────
# WINDOW_START_HOUR=8
# WINDOW_END_HOUR=22
# MORNING_DRIFT_MIN=40                         # randomize the daily start time
# DAILY_CAP=300                                # hard ceiling to stay in free-tier limits
# END_OF_QUEUE=stop                            # stop | refresh (wrap to re-enrich oldest)

# ── Scheduler: per-profile human pacing (ms) ───────────────────────────────────
# PER_PROFILE_MIN_MS=3000
# PER_PROFILE_MAX_MS=15000

# ── Circuit breaker ────────────────────────────────────────────────────────────
# BREAKER_INRUN_CONSEC=5      # abort a run after N consecutive blocked profiles
# BREAKER_BADRUN_RATE=0.4     # a run is "bad" if blocked/attempted ≥ this
# BREAKER_HARD_AFTER=3        # hard-PAUSE after N consecutive bad runs
# BACKOFF_MULT=2              # gap multiplier per consecutive bad run
# BACKOFF_CAP_MIN=280         # cap the backed-off gap (minutes)
# AUTO_RESUME_AFTER_MIN=0     # 0 = hard PAUSE stays until you clear it; >0 = auto-resume cooldown

# ── Depth: Basic enrichers (optional — graceful skip without) ──────────────────
# OPENFEC_API_KEY=            # free via api.data.gov — raises rate limit from DEMO_KEY
# CONGRESS_API_KEY=           # free via api.data.gov — required for Congress.gov enricher

# ── Depth: Advanced enrichers ─────────────────────────────────────────────────
# SAM_API_KEY=                # free via SAM.gov — federal contractor / exclusion lookup
# USAJOBS_API_KEY=            # free via USAJOBS developer portal — federal hiring signals
# EIA_API_KEY=                # free via eia.gov/opendata — energy plant ownership

# ── Depth: Deep enrichers ─────────────────────────────────────────────────────
# HF_TOKEN=                   # HuggingFace read token — optional for public data (raises rate limit)
