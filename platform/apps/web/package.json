{
  "name": "@bridge/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real platform frontend — ports the prototype's design, routed entirely through @bridge/api's governed tRPC surface (docs/raw/frontend-migration-scoping.md).",
  "scripts": {
    "generate:pending-work": "node ../../scripts/generate-pending-work.mjs",
    "prebuild": "pnpm generate:pending-work",
    "build": "vite build",
    "predev": "pnpm generate:pending-work",
    "dev": "vite",
    "preview": "vite preview",
    "test": "node --test-reporter=dot --test src/app/data/*.test.mjs test/*.test.mjs",
    "test:coverage": "node --test src/app/data/*.test.mjs test/*.test.mjs",
    "test:ui-conformance": "node --test-reporter=dot --test test/ui-conformance.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bridge/api": "workspace:*",
    "@bridge/core": "workspace:*",
    "@bridge/module-manifests": "workspace:*",
    "@bridge/research": "workspace:*",
    "@bridge/tables": "workspace:*",
    "@bridge/whatsapp": "workspace:*",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@supabase/supabase-js": "^2.110.1",
    "@trpc/client": "^11.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "leaflet": "^1.9.4",
    "lodash": "^4.18.1",
    "lucide-react": "0.487.0",
    "marked": "^18.0.5",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-responsive-carousel": "^3.2.23",
    "react-router": "^7.15.0",
    "tailwind-merge": "3.2.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/lodash": "^4.17.24",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
