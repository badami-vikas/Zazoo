{
  "name": "@zazoo/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public Zazoo cinematic website.",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
