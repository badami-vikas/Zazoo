# @bridge/api hosted-container production pilot. Values here are placeholders;
# inject real credentials from the container host's secret manager, never from a
# committed file. The desktop-local pilot does not use this hosted Local Plane
# block: Tauri supplies BRIDGE_ENV=production, BRIDGE_LOCAL_RESIDENCY=desktop-local,
# an app-data BRIDGE_LOCAL_DIR, and the os-keyring vault while inheriting only
# Supabase Postgres/Auth configuration.

NODE_ENV=production
API_HOST=0.0.0.0
PORT=4000
API_ALLOWED_ORIGINS=https://<web-host>

# Dedicated least-privilege bridge_app role. This example uses the shared
# Supavisor session pooler for a persistent IPv4-only container; use bridge_app
# without the project suffix on a direct IPv6 connection. URL-encode the
# password. Never use postgres, service_role, or a BYPASSRLS role.
DATABASE_URL=postgresql://bridge_app.<project-ref>:<url-encoded-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# One-off migration jobs use an owner/session-pooler URL through
# MIGRATION_DATABASE_URL. Do not inject that variable into the API container.

# Supabase Auth project and the one approved pilot account. The API verifies JWTs
# from SUPABASE_URL and admits only this exact subject.
SUPABASE_URL=https://<project-ref>.supabase.co
BRIDGE_PILOT_USER_ID=<supabase-auth-user-uuid>
BRIDGE_PILOT_USER_EMAIL=<pilot-email>

# Mount one durable host-encrypted volume at /var/lib/bridge. These paths contain
# Local Plane state and files and must survive container replacement.
BRIDGE_LOCAL_DIR=/var/lib/bridge/local
BRIDGE_FILES_ROOT=/var/lib/bridge/files
BRIDGE_LOCAL_RESIDENCY=encrypted-host-volume

# Headless credential vault on that encrypted volume. Generate a key with:
# openssl rand -base64 32
BRIDGE_DEALPILOT_CREDENTIAL_VAULT=encrypted-file
BRIDGE_CREDENTIAL_VAULT_KEY_ID=<current-key-id>
BRIDGE_CREDENTIAL_VAULT_KEY=<base64-32-byte-key>

# During rotation, move the former current pair here. Remove these after every
# credential entry has been rewritten with the new current key.
# BRIDGE_CREDENTIAL_VAULT_PREVIOUS_KEY_ID=<former-key-id>
# BRIDGE_CREDENTIAL_VAULT_PREVIOUS_KEY=<former-base64-32-byte-key>

# Optional private, self-hosted Nominatim-compatible geocoder. Bridge rejects
# public hosts so Location labels cannot leave the Local Plane.
# BRIDGE_LOCAL_GEOCODER_URL=http://127.0.0.1:8080/
