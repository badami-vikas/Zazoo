# @bridge/api production pilot. Values are placeholders; enter private values
# directly in the provider secret manager, never in a committed file.

NODE_ENV=production
API_HOST=0.0.0.0
PORT=4000

# Render Blueprint derives the exact HTTPS CORS origin from this bare hostname.
# Outside Render, omit this and set API_ALLOWED_ORIGINS=https://<web-host>.
BRIDGE_RENDER_WEB_HOST=<render-static-host>

# Dedicated least-privilege bridge_app role. This example uses the shared
# Supavisor session pooler for a persistent IPv4-only container; use bridge_app
# without the project suffix on a direct IPv6 connection. URL-encode the
# password. Never use postgres, service_role, or a BYPASSRLS role.
DATABASE_URL=postgresql://bridge_app.<project-ref>:<url-encoded-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# One-off migration jobs use an owner/session-pooler URL through
# MIGRATION_DATABASE_URL. Do not inject that variable into the API container.

# Supabase Auth project and the one approved pilot account. The API verifies JWTs
# from SUPABASE_URL and admits only this exact subject.
SUPABASE_URL=https://<project-ref>.supabase.co
BRIDGE_PILOT_USER_ID=<supabase-auth-user-uuid>
BRIDGE_PILOT_USER_EMAIL=<pilot-email>

# Cloud-Plane chat ModelProvider for the hosted web app. Set ONE of the keys
# below; with no cloud provider registered the Chat Panel fails closed with
# "No authorized cloud model provider is configured" rather than faking a reply.
# Local-plane (desktop) chat uses the on-device llama.cpp runtime and needs none.
#
# GROQ_API_KEY (groq.com) registers GroqProvider — the recommended low/no-cost
# option (free tier). Default model openai/gpt-oss-20b; override with GROQ_MODEL.
# You can instead save the key in the desktop app under Settings → API Keys
# (ADR-181); it goes to the OS keyring / encrypted-file credential vault and is
# read at the NEXT boot. This environment variable still wins when it is set.
GROQ_API_KEY=<groq-api-key>
# GROQ_MODEL=<model-id>
#
# OPENROUTER_API_KEY (openrouter.ai) registers OpenRouterProvider — the
# PREFERRED Chat/Avatar model (default stealth/ox-alpha; override with
# OPENROUTER_MODEL). Groq is the chat fallback when this is unset.
# OPENROUTER_API_KEY=<openrouter-api-key>
# OPENROUTER_MODEL=<model-id>
#
# ANTHROPIC_API_KEY registers AnthropicProvider — higher quality but metered.
# Default claude-fable-5 (default/reasoning), claude-haiku-4-5-20251001 (cheap).
# ANTHROPIC_API_KEY=<anthropic-api-key>
# ANTHROPIC_MODEL=<model-id>
# ANTHROPIC_CHEAP_MODEL=<model-id>
# ANTHROPIC_REASONING_MODEL=<model-id>

# Free Render boundary: scratch DB exists only so shared composition can boot.
# The API gate rejects every private/local operation, and no disk is mounted.
BRIDGE_LOCAL_DIR=/tmp/bridge-public-only/local
BRIDGE_FILES_ROOT=/tmp/bridge-public-only/files
BRIDGE_LOCAL_RESIDENCY=public-cloud
BRIDGE_DEALPILOT_CREDENTIAL_VAULT=disabled

# Alternative paid/explicitly-approved hosted Local Plane only:
# BRIDGE_LOCAL_DIR=/var/lib/bridge/local
# BRIDGE_FILES_ROOT=/var/lib/bridge/files
# BRIDGE_LOCAL_RESIDENCY=encrypted-host-volume
# BRIDGE_DEALPILOT_CREDENTIAL_VAULT=encrypted-file
# BRIDGE_CREDENTIAL_VAULT_KEY_ID=<current-key-id>
# BRIDGE_CREDENTIAL_VAULT_KEY=<base64-32-byte-key>
# BRIDGE_CREDENTIAL_VAULT_PREVIOUS_KEY_ID=<former-key-id>
# BRIDGE_CREDENTIAL_VAULT_PREVIOUS_KEY=<former-base64-32-byte-key>

# Optional private, self-hosted Nominatim-compatible geocoder. Bridge rejects
# public hosts so Location labels cannot leave the Local Plane.
# BRIDGE_LOCAL_GEOCODER_URL=http://127.0.0.1:8080/
