# @bridge/api — Universal Action Pipeline server.
#
# Zero-infra by default: with no DATABASE_URL the pipeline runs on in-memory adapters
# (governance + ledger live in process; a dev Outreach Agent is seeded so the prototype's
# Signal→propose loop works without a database).
#
# Set DATABASE_URL to bind the pipeline to Postgres — the SAME `ledger` the prototype reads.
# Use the Supabase pooler connection string (Project → Connect → ORMs). The app surface must NOT
# use the service-role bypass; reserve that for the derivation pipeline.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Live Bridge AI project ref: emtbimowmqqhixqlxhzb
# DATABASE_URL=

# HTTP port (default 4000). The prototype's VITE_API_URL must point here.
# PORT=4000
