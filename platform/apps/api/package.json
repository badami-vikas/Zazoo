{
  "name": "@bridge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify 5 + tRPC 11 surface over the Universal Action Pipeline.",
  "files": [
    "dist",
    "migrations-accounting"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test-concurrency=4 --test-reporter=dot --test dist/test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='dist/src/**' --test-coverage-exclude='**/test/**' --test-coverage-lines=60 --test-concurrency=4 --test dist/test/*.test.js",
    "typecheck": "tsc -b --noEmit false",
    "dev": "node --watch dist/src/server.js",
    "start": "node dist/src/server.js",
    "publish-builtins": "node dist/src/scripts/publish-builtins.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.258",
    "@bridge/accounting": "workspace:*",
    "@bridge/capability-kit": "workspace:*",
    "@bridge/company-sourcing": "workspace:*",
    "@bridge/core": "workspace:*",
    "@bridge/d2c": "workspace:*",
    "@bridge/db": "workspace:*",
    "@bridge/dealpilot": "workspace:*",
    "@bridge/dedupe": "workspace:*",
    "@bridge/devpilot": "workspace:*",
    "@bridge/facts": "workspace:*",
    "@bridge/integrations-github": "workspace:*",
    "@bridge/integrations-google": "workspace:*",
    "@bridge/jobpilot": "workspace:*",
    "@bridge/local": "workspace:*",
    "@bridge/models": "workspace:*",
    "@bridge/module-manifests": "workspace:*",
    "@bridge/net-guard": "workspace:*",
    "@bridge/research": "workspace:*",
    "@bridge/sensors": "workspace:*",
    "@bridge/tables": "workspace:*",
    "@bridge/whatsapp": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@trpc/server": "^11.0.0",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "jose": "^6.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
