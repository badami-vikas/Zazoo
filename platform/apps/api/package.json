{
  "name": "@bridge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify 5 + tRPC 11 surface over the Universal Action Pipeline.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --experimental-test-coverage --test-coverage-exclude='**/test/**' --test-coverage-lines=60 --test dist/test/*.test.js",
    "typecheck": "tsc -b --noEmit false",
    "dev": "node --watch dist/src/server.js",
    "start": "node dist/src/server.js",
    "publish-builtins": "node dist/src/scripts/publish-builtins.js"
  },
  "dependencies": {
    "@bridge/company-sourcing": "workspace:*",
    "@bridge/core": "workspace:*",
    "@bridge/db": "workspace:*",
    "@bridge/dealpilot": "workspace:*",
    "@bridge/dedupe": "workspace:*",
    "@bridge/facts": "workspace:*",
    "@bridge/helpdesk": "workspace:*",
    "@bridge/integrations-google": "workspace:*",
    "@bridge/jobpilot": "workspace:*",
    "@bridge/local": "workspace:*",
    "@bridge/net-guard": "workspace:*",
    "@bridge/models": "workspace:*",
    "@bridge/capability-kit": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@trpc/server": "^11.0.0",
    "fastify": "^5.2.0",
    "jose": "^6.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
