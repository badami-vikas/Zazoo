{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bridge",
  "version": "0.1.0",
  "identifier": "ai.bridge.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": {
      "script": "pnpm prepare:dev",
      "wait": false
    },
    "beforeBuildCommand": "pnpm prepare:bundle"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://localhost:5173 ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/bridge-node"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "frameworks": [
        "generated/native/bridge-keyring.dylib"
      ],
      "entitlements": "Bridge.entitlements"
    },
    "resources": {
      "generated/api/": "api/",
      "generated/licenses/": "licenses/",
      "generated/llama/": "llama/",
      "../model-runtime-manifest.json": "model-runtime-manifest.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Bridge — Living Software desktop shell",
    "longDescription": "Bridge desktop shell (Tauri v2): hosts the web client and adds the native Rust capture core + overlay avatar. No kernel logic lives here."
  }
}
