{
  "name": "@bridge/models",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real ModelProvider and SearchProvider implementations plus governed provider routers. @bridge/core keeps the ports types-only; network adapters and safe HTTP live here.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --experimental-test-coverage --test-coverage-exclude='**/test/**' --test-coverage-lines=35 --test dist/test/*.test.js"
  },
  "dependencies": {
    "@bridge/core": "workspace:*",
    "@bridge/tool-kit": "workspace:*",
    "ipaddr.js": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
