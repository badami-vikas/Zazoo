{
  "name": "@bridge/models",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real ModelProvider and SearchProvider implementations plus governed provider routing.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --test dist/test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='dist/src/**' --test-coverage-exclude='**/test/**' --test-coverage-lines=35 --test dist/test/*.test.js"
  },
  "dependencies": {
    "@bridge/core": "workspace:*",
    "@bridge/capability-kit": "workspace:*",
    "@bridge/net-guard": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
