{
  "name": "@bridge/integrations-google",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Gmail + Google Calendar integration \u2014 the EGRESS adapter (googleapis), pipeline Skills (source/compose), the IntakeService (source\u2192match\u2192propose) and the EgressExecutor (approved send/write through the gate). Reads feed the graph by approval; writes are draft-then-approve.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "dependencies": {
    "@bridge/core": "workspace:*",
    "@bridge/db": "workspace:*",
    "@bridge/local": "workspace:*",
    "@googleapis/calendar": "^11.0.0",
    "@googleapis/gmail": "^13.0.0",
    "google-auth-library": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --experimental-test-module-mocks --test-reporter=dot --test dist/test/*.test.js",
    "test:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include='dist/src/**' --test-coverage-exclude='**/test/**' --test dist/test/*.test.js"
  }
}
