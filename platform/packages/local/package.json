{
  "name": "@bridge/local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The LOCAL plane — customer-controlled private tier (pglite/Postgres via ports/adapters). OAuth tokens, raw Gmail/Calendar bodies, and derived Events/Memories/Signals live here and NEVER cross the gate to cloud canonical.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@ster5/global-mutex": "^3.3.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --experimental-test-coverage --test-coverage-exclude='**/test/**' --test-coverage-lines=70 --test dist/test/*.test.js"
  }
}
