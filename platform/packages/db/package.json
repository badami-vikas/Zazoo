{
  "name": "@bridge/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema mirroring docs/raw/SCHEMA.sql + Postgres/Supabase client + core port bindings.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./schema": {
      "types": "./dist/src/schema.d.ts",
      "default": "./dist/src/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --test dist/test/*.test.js",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@bridge/core": "workspace:*",
    "@electric-sql/pglite": "^0.2.17",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.3"
  }
}
