{
  "name": "@bridge/tables",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Schema-driven columns, canonical views-as-data, and a swappable PersistencePort for every Database surface.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --test-reporter=dot --test dist/test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='dist/src/**' --test-coverage-exclude='**/test/**' --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
