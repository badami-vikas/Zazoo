{
  "name": "@bridge/commons",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Universal Commons — local-first curated Module registry (generalized capability content ONLY, never user data). Same HTTP contract as the future Bridge Cloud registry.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --test-reporter=dot --test dist/test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='dist/src/**' --test-coverage-exclude='**/test/**' --test dist/test/*.test.js",
    "dev": "node --watch dist/src/main.js",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@bridge/core": "workspace:*",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
