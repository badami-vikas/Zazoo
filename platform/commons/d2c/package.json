{
  "name": "@bridge/d2c",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "D2C Module domain layer (imported from CV Naturals, ADR-246): schema, product-to-source mapping, formula costing, order lifecycle, invoice numbering, and the stock ledger. Backs the Orders, Inventory, Research and Notes sub-modules. No I/O, no framework — the host app owns persistence and the WhatsApp boundary, which is served by @bridge/whatsapp.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./module": {
      "types": "./dist/src/module.d.ts",
      "default": "./dist/src/module.js"
    },
    "./drizzle-schema": {
      "types": "./dist/src/drizzle-schema.d.ts",
      "default": "./dist/src/drizzle-schema.js"
    },
    "./migrations": {
      "types": "./dist/src/migrations.d.ts",
      "default": "./dist/src/migrations.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run",
    "test:coverage": "vitest run"
  },
  "dependencies": {
    "@bridge/core": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
