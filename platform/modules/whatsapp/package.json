{
  "name": "@bridge/whatsapp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "WhatsApp Module package. Pure normalization and mapping from a WhatsApp Web extraction into People, Community, and Relation proposals, plus the Module manifest and Tool registry. Holds no session, no DOM, and no network — the session lives only in the desktop shell's contained webview.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./module": {
      "types": "./dist/src/module.d.ts",
      "default": "./dist/src/module.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --test-reporter=dot --test dist/test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='dist/src/**' --test-coverage-exclude='**/test/**' --test-coverage-lines=70 --test dist/test/*.test.js"
  },
  "dependencies": {
    "@bridge/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
