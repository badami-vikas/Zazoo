{
  "name": "@bridge/jobpilot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "JobPilot Module package. Composes company and people sourcing Engines with JobPilot-owned scoring, evaluation, and Database logic.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --experimental-test-coverage --test-coverage-exclude='**/test/**' --test-coverage-lines=70 --test dist/test/*.test.js"
  },
  "dependencies": {
    "@bridge/capability-kit": "workspace:*",
    "@bridge/company-sourcing": "workspace:*",
    "@bridge/people-sourcing": "workspace:*",
    "@bridge/dedupe": "workspace:*",
    "@bridge/facts": "workspace:*",
    "@bridge/module-manifests": "workspace:*",
    "@bridge/sourcing": "workspace:*",
    "@bridge/tables": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
