{
  "name": "@bridge/module-manifests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Canonical built-in Bridge Module manifests and runtime bindings.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@bridge/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
