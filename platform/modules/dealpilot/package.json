{
  "name": "@bridge/dealpilot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "DealPilot Module package. Composes company sourcing, deduplication, facts, recording, and governed sourcing Engines behind its manifest and registration boundary.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --experimental-test-coverage --test-coverage-include='dist/src/**' --test-coverage-exclude='**/test/**' --test-coverage-lines=70 --test dist/test/*.test.js"
  },
  "dependencies": {
    "@bridge/company-sourcing": "workspace:*",
    "@bridge/dedupe": "workspace:*",
    "@bridge/facts": "workspace:*",
    "@bridge/integrations-google": "workspace:*",
    "@bridge/module-manifests": "workspace:*",
    "@bridge/people-sourcing": "workspace:*",
    "@bridge/recorder": "workspace:*",
    "@bridge/sourcing": "workspace:*",
    "@bridge/tables": "workspace:*",
    "@bridge/capability-kit": "workspace:*",
    "@napi-rs/keyring": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
